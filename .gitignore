!assets/classes/assassin_talent_icons.webp.import
!assets/classes/tooth_fairy_talent_icons.webp.import
!assets/classes/ember_talent_icons.webp.import
!assets/classes/rinser_talent_icons.webp.import
!assets/classes/frost_warden_talent_icons.webp.import
!assets/classes/tooth_fairy_portrait.png.import
!assets/classes/ember_portrait.png.import
!assets/classes/rinser_portrait.png.import
!assets/classes/frost_warden_portrait.png.import
!assets/classes/necrodent_portrait.png.import
!assets/classes/necrodent_retinue.png.import
!assets/classes/necrodent_talent_icons.png.import
!assets/classes/necrodent_tooth_roles.png.import
!assets/weapons/extraction_staff.png.import
!assets/vfx/element_hit_splats.png.import

# The modular Count artwork uses mipmaps at combat sprite sizes.
!assets/enemies/count_rig/parts.png.import
!assets/enemies/prince_caramel/parts.png.import

!assets/enemies/king_acid/parts.png.import
!assets/enemies/king_acid/acid_stream.png.import
!assets/enemies/king_acid/portrait.png.import
!assets/enemies/emperor_court/parts.png.import
!assets/enemies/emperor_court/portrait.png.import
!assets/enemies/imperial_vassals/*.png.import
!assets/enemies/caramel_enforcer/*.png.import
!assets/enemies/acid_collector/*.png.import

# Painted run-preparation motifs stay smooth at small card sizes.
!assets/ui/run_setup/*.png.import

# Approved weapon skins retain mipmaps in fresh checkouts and exports.
!assets/weapons/element_forms/*/*.png.import

# Painted mastery seals remain crisp at selection-card scale.
!assets/ui/weapon_mastery_badges.png.import
