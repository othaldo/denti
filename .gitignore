.godot/
__pycache__/
*.import
!docs/status_distribution.csv.import
/addons/
/.codex/
/.mcp.json
.codex-remote-*
/build/
/dist/

# Upgrade capsule uses a small runtime import with mipmaps.
!assets/loot/upgrade_capsule.png.import

# Keep the small stat icon's mipmap import settings in fresh checkouts/exports.
!assets/ui/stamina_icon.png.import
!assets/ui/element_icons_atlas.png.import
!assets/ui/weapon_support_icons_atlas.png.import
!assets/vfx/element_hit_splats.png.import

# The modular Count artwork uses mipmaps at combat sprite sizes.
!assets/enemies/count_rig/parts.png.import
!assets/enemies/prince_caramel/parts.png.import

!assets/enemies/king_acid/parts.png.import
!assets/enemies/king_acid/acid_stream.png.import
!assets/enemies/king_acid/portrait.png.import
!assets/enemies/emperor_court/parts.png.import
!assets/enemies/emperor_court/portrait.png.import

# Painted run-preparation motifs stay smooth at small card sizes.
!assets/ui/run_setup/*.png.import

# Approved weapon skins retain mipmaps in fresh checkouts and exports.
!assets/weapons/element_forms/*/*.png.import

# Painted mastery seals remain crisp at selection-card scale.
!assets/ui/weapon_mastery_badges.png.import
