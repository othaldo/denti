[resource]
script = ExtResource("1")
id = &"ember"
tagline = "Heiß gelaufen: Hitze aufbauen und mitten in der Horde ausbrechen."
play_style = Array[String](["Treffer und nahe Gegner laden Hitze, bei voller Hitze bricht Feuer aus", "Je mehr Gegner um dich stehen, desto stärker der Ausbruch", "Danach kurz überhitzt; weniger Schmelz, schwache Fernwaffen"])
