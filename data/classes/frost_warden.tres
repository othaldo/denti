[resource]
script = ExtResource("1")
id = &"frost_warden"
tagline = "Bis hierhin und nicht weiter: Dein Dash zieht eine Eiswand."
play_style = Array[String](["Setz Eiswände quer zur Horde: Gegner stauen sich und kühlen aus", "Wer lange an der Wand steht, wird spröde", "Langsamer, nur ein Dash; Bosse brechen durch"])
portrait = ExtResource("3")
combat_sprite = ExtResource("3")
