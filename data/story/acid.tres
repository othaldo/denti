arrival_dialogue = Array[Dictionary]([{"speaker":"Denti","text":"Zwei Fragmente. Und Zucker zwischen allen Wurzeln."},
{"speaker":"Zahnfee","text":"Das nächste Portal ist offen. Lass die Süßigkeiten liegen."},
{"speaker":"Denti","text":"Keine Sorge. Ich habe genug davon.","enter":2},
{"speaker":"Denti","text":"Mundspülung? Das riecht eher nach Rohrreiniger."}])
