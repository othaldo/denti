[resource]
script = ExtResource("1")
boss = ExtResource("3")
boss_dialogue = Array[Dictionary]([{"speaker":"Karies-Imperator","text":"Du hast meine Herrscher besiegt. Für einen losen Zahn hast du erstaunlich viel Biss."},
{"speaker":"Denti","text":"Gib die Zahnfee frei. Dann räume ich nur deine Krone ab."},
{"speaker":"Karies-Imperator","text":"Ich bin die Karies. Solange jemand Zucker isst, kehre ich zurück."},
{"speaker":"Denti","text":"Vielleicht. Aber heute ziehe ich dir die Krone. Die Zahnfee kommt mit mir."},
{"speaker":"Karies-Imperator","text":"Du kannst mich nicht besiegen. Nur aufschieben."},
{"speaker":"Denti","text":"Dann schiebe ich eben zweimal täglich. Mit Zahnseide. Wir sehen uns beim nächsten Kontrolltermin.","action":"Kämpfen"}])
id = &"palace"
title = "Die letzte Krone"
objective = "Besiege den Imperator und befreie die Zahnfee."
floor_texture = ExtResource("2")
wall_color = Color(0.2784313725490196, 0.2235294117647059, 0.30980392156862746, 1)
void_color = Color(0.13333333333333333, 0.10588235294117647, 0.16862745098039217, 1)
trim_color = Color(0.788235294117647, 0.6431372549019608, 0.4235294117647059, 1)
arrival_dialogue = Array[Dictionary]([{"speaker":"Zahnfee","text":"Drei Fragmente. Jetzt reicht die Magie bis zu meinem Gefängnis."},
{"speaker":"Denti","text":"Ich wollte nur zurück in meinen Mund. Inzwischen will ich dem Imperator persönlich die Krone ziehen."},
{"speaker":"Zahnfee","text":"Geh durch das Portal. Ich bin auf der anderen Seite.","enter":3},
{"speaker":"Denti","text":"Gold, Marmorsäulen und Karies. Jemand hat bei der Reinigung gespart."}])
