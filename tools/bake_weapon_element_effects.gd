extends SceneTree
## Compile existing painted combat artwork into element-specific runtime atlases.
## Source sheets and enemy projectiles remain untouched. No runtime rasterization.

const ELEMENTS := [&"fire", &"ice", &"poison", &"electric", &"bleed", &"wet"]
const CELL := Vector2i(256, 128)
const FRAMES := 4


func _initialize() -> void:
	call_deferred("_run")


func _tinted(source: Image, tint: Color, saturation_floor: float = 0.0) -> Image:
	var result := source.duplicate() as Image
	result.convert(Image.FORMAT_RGBA8)
	for y in result.get_height():
		for x in result.get_width():
			var pixel := result.get_pixel(x, y)
			if pixel.a <= 0:
				continue
			# Move painted hue, preserving highlights, shadows and the source alpha.
			var saturation := maxf(pixel.s * 0.95, saturation_floor * (1.0 - 0.65 * pow(pixel.v, 4)))
			var colored := Color.from_hsv(tint.h, minf(saturation, tint.s), pixel.v, pixel.a)
			result.set_pixel(x, y, colored)
	return result


func _run() -> void:
	var attacks := AttackEffects.ATLAS.get_image()
	var effects := Image.create(1024, 3840, false, Image.FORMAT_RGBA8)
	var entries: Array[Dictionary] = []
	var cursor := Vector2i(2, 2)
	var row_height := 0
	for index in ELEMENTS.size():
		var id: StringName = ELEMENTS[index]
		var definition := WeaponAffixes.by_id(id)
		for style in [7, 11, 13]:
			var kind: ProjectilePaint.Kind = ProjectilePaint.Kind.ROCKET if style == 13 else definition.projectile_art_kind as ProjectilePaint.Kind
			var shot := _tinted(ProjectilePaint.image(kind, float(style)), definition.color)
			if cursor.x + shot.get_width() + 2 > 1024:
				cursor = Vector2i(2, cursor.y + row_height + 4)
				row_height = 0
			entries.append({"key": "%s:%s" % [id, "rocket" if style == 13 else str(style)], "image": shot, "at": cursor})
			cursor.x += shot.get_width() + 4
			row_height = maxi(row_height, shot.get_height())
		var shapes := [definition.attack_stream_art, definition.attack_trail_art,
			definition.attack_spray_art, AttackEffects.Shape.FLASH]
		for shape in 5:
			for frame in FRAMES:
				var tile: Image
				if shape == 4:
					tile = GroundEffects.ATLAS.get_image().get_region(Rect2i(0, 0, 384, 384))
					tile.resize(CELL.x, CELL.y, Image.INTERPOLATE_LANCZOS)
				else:
					tile = attacks.get_region(Rect2i(frame * CELL.x, int(shapes[shape]) * CELL.y, CELL.x, CELL.y))
				tile = _tinted(tile, definition.color, 0.65)
				# Decorate with the same painted material as the projectile. Facets,
				# droplets and arrow sparks make impacts/streams differ in silhouette.
				if shape != 4:
					_details(tile, definition, frame, shape == 3)
				_clear_gutters(tile)
				effects.blit_rect(tile, Rect2i(Vector2i.ZERO, CELL), Vector2i(frame * CELL.x, (index * 5 + shape) * CELL.y))
	var atlas := Image.create(1024, cursor.y + row_height + 2, false, Image.FORMAT_RGBA8)
	var source := "# Generated by tools/bake_weapon_element_effects.gd.\nextends RefCounted\n\nconst PROJECTILES: Texture2D = preload(\"res://assets/vfx/weapon_element_projectiles.png\")\nconst EFFECTS: Texture2D = preload(\"res://assets/vfx/weapon_element_effects.png\")\nconst REGIONS := {\n"
	for entry in entries:
		atlas.blit_rect(entry.image, Rect2i(Vector2i.ZERO, entry.image.get_size()), entry.at)
		source += "\t\"%s\": Rect2(%d, %d, %d, %d),\n" % [entry.key, entry.at.x, entry.at.y, entry.image.get_width(), entry.image.get_height()]
	source += "}\n\nstatic var textures: Dictionary[String, Texture2D] = {}\n\nstatic func find(key: String) -> Texture2D:\n\tif not REGIONS.has(key): return null\n\tif not textures.has(key):\n\t\tvar frame := AtlasTexture.new()\n\t\tframe.atlas = PROJECTILES\n\t\tframe.region = REGIONS[key]\n\t\tframe.filter_clip = true\n\t\ttextures[key] = frame\n\treturn textures[key]\n"
	assert(atlas.save_png("res://assets/vfx/weapon_element_projectiles.png") == OK)
	assert(effects.save_png("res://assets/vfx/weapon_element_effects.png") == OK)
	var file := FileAccess.open("res://scripts/systems/prepared_weapon_element_effects.gd", FileAccess.WRITE)
	file.store_string(source)
	print("PASS baked 18 elemental projectile styles and 120 attack-effect frames from existing painted artwork")
	quit()


func _details(tile: Image, definition: WeaponAffixData, frame: int, burst: bool) -> void:
	var bit := _tinted(ProjectilePaint.image(definition.projectile_art_kind as ProjectilePaint.Kind, 7.0), definition.color)
	var rect := bit.get_used_rect()
	bit = bit.get_region(rect)
	var factor := 15.0 / maxf(bit.get_width(), bit.get_height())
	bit.resize(maxi(roundi(bit.get_width() * factor), 1), maxi(roundi(bit.get_height() * factor), 1), Image.INTERPOLATE_LANCZOS)
	for index in 3:
		var at: Vector2i
		if burst:
			var angle := float(index) * TAU / 3.0 + 0.4
			at = Vector2i(Vector2(128, 64) + Vector2(cos(angle) * 70, sin(angle) * 38) * (0.6 + frame * 0.1))
		else:
			at = Vector2i(45 + index * 70 + frame * 3, 38 + (index % 2) * 46)
		tile.blend_rect(bit, Rect2i(Vector2i.ZERO, bit.get_size()), at - bit.get_size() / 2)


func _clear_gutters(tile: Image) -> void:
	for y in tile.get_height():
		for x in tile.get_width():
			if x < 3 or x >= tile.get_width() - 3 or y < 3 or y >= tile.get_height() - 3:
				tile.set_pixel(x, y, Color.TRANSPARENT)
