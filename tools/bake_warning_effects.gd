extends SceneTree
## Offline only: the same clean boundary language as the prepared danger circles.
## Run before bake_attack_effects.py. No painted source art is modified.

const WIDTH := 1024
const HEIGHT := 1792
var image: Image

func _initialize() -> void:
	image = Image.create(WIDTH, HEIGHT, false, Image.FORMAT_RGBA8)
	var fan: CloakStrikeData = load("res://data/encounters/count_fan.tres")
	var thrust: CloakStrikeData = load("res://data/encounters/count_thrust.tres")
	var ring: CloakStrikeData = load("res://data/encounters/count_ring.tres")
	_sector(Rect2i(0, 0, 384, 480), fan.reach, fan.half_angle_degrees, false)
	_sector(Rect2i(384, 0, 384, 480), fan.reach, fan.half_angle_degrees, true)
	_sector(Rect2i(0, 480, 384, 288), fan.reach, fan.edge_half_angle_degrees, false)
	_sector(Rect2i(384, 480, 384, 288), fan.reach, fan.edge_half_angle_degrees, true)
	_sector(Rect2i(0, 768, 448, 224), thrust.reach, thrust.half_angle_degrees, false)
	_sector(Rect2i(448, 768, 448, 224), thrust.reach, thrust.half_angle_degrees, true)
	_ring(Rect2i(0, 992, 608, 608), ring.inner_radius, ring.reach)
	var ground := Image.load_from_file("res://assets/vfx/ground_effects.png")
	image.blit_rect(ground, Rect2i(384, 0, 384, 384), Vector2i(608, 1000))
	for frame in 4: _lane(frame)
	_charge()
	var result := image.save_png("res://assets/vfx/warning_shapes.png")
	var metadata := FileAccess.open("res://scripts/systems/prepared_warning_shapes.gd", FileAccess.WRITE)
	metadata.store_string("# Generated by tools/bake_warning_effects.gd. Regenerate when profiles change.\nextends RefCounted\n")
	var values := {"FAN_REACH": fan.reach, "FAN_ANGLE": fan.half_angle_degrees, "EDGE_ANGLE": fan.edge_half_angle_degrees, "THRUST_REACH": thrust.reach, "THRUST_ANGLE": thrust.half_angle_degrees, "RING_INNER": ring.inner_radius, "RING_OUTER": ring.reach}
	for key in values: metadata.store_string("const %s := %.6f\n" % [key, values[key]])
	print("Warning source atlas: ", image.get_size(), ", result ", result)
	quit(0 if result == OK else 1)

func _ink(distance: float, inside: bool, glow_only := false) -> Color:
	var edge := exp(-pow(distance / 1.05, 2)) * 0.82
	var glow := exp(-pow(distance / 3.0, 2)) * 0.16
	var fill := 0.075 if inside and not glow_only else 0.0
	return Color(1, 1, 1, clampf(edge + glow + fill, 0, 1))

func _charge() -> void:
	# Neutral feathered light: no box sides, corner caps or outlined rectangle.
	for y in 64:
		for x in 64:
			var u := (x + 0.5) / 64.0
			var v := absf((y + 0.5 - 32) / 32.0)
			var feather := 1.0 - smoothstep(0.68, 0.98, v)
			var body := (0.15 + 0.19 * exp(-pow(v / 0.42, 2))) * feather
			image.set_pixel(0 + x, 1728 + y, Color(1, 1, 1, body))
			image.set_pixel(64 + x, 1728 + y, Color(1, 1, 1, body * smoothstep(0, 0.95, u)))
			# A softly curved wavefront, tapering naturally at both sides.
			var nose := 0.92 - v * v * 0.42
			var core := exp(-pow((u - nose) / 0.055, 2)) * 0.75
			var glow := exp(-pow((u - nose) / 0.19, 2)) * 0.28
			var behind := body * (1.0 - smoothstep(nose - 0.08, nose + 0.04, u))
			image.set_pixel(128 + x, 1728 + y, Color(1, 1, 1, minf(behind + (core + glow) * feather, 1)))
			var p := Vector2(x + 0.5 - 32, y + 0.5 - 32) / 28.0
			var radius := p.length()
			var angle := p.angle()
			# Warm impact dust and broken radial embers, without a circular outline.
			var turbulence := 0.035 * sin(angle * 5 + radius * 7) + 0.025 * cos(angle * 9 - radius * 4)
			var dust := (1 - smoothstep(0.5, 1.08, radius + turbulence)) * 0.42
			dust += exp(-pow(radius / 0.32, 2)) * 0.18
			var ray := pow(maxf(cos(angle * 7 + sin(radius * 9) * 0.5), 0), 18)
			var embers := ray * smoothstep(0.16, 0.4, radius) * (1 - smoothstep(0.62, 0.96, radius)) * 0.65
			embers += exp(-pow(radius / 0.17, 2)) * 0.4
			image.set_pixel(192 + x, 1728 + y, Color(1, 1, 1, dust))
			image.set_pixel(256 + x, 1728 + y, Color(1, 1, 1, embers))

func _sector(rect: Rect2i, reach: float, degrees: float, arc_only: bool) -> void:
	var half := deg_to_rad(degrees)
	var upper := Vector2.from_angle(half)
	var lower := Vector2.from_angle(-half)
	for y in rect.size.y:
		for x in rect.size.x:
			var p := Vector2(x + 0.5 - 8, y + 0.5 - rect.size.y * 0.5)
			var radius := p.length()
			var angle := absf(p.angle())
			var in_angle := angle <= half
			var inside := in_angle and radius <= reach
			var distance := absf(radius - reach) if in_angle else p.distance_to(upper * reach if p.y >= 0 else lower * reach)
			if not arc_only:
				distance = minf(distance, p.distance_to(Geometry2D.get_closest_point_to_segment(p, Vector2.ZERO, upper * reach)))
				distance = minf(distance, p.distance_to(Geometry2D.get_closest_point_to_segment(p, Vector2.ZERO, lower * reach)))
			var color := _ink(distance, inside, arc_only)
			if arc_only:
				color.a = clampf(exp(-pow(distance / 2.2, 2)) * 0.70 + exp(-pow(distance / 5.0, 2)) * 0.22, 0, 1)
				color.a *= smoothstep(half + 0.01, half - 0.035, angle)
			image.set_pixelv(rect.position + Vector2i(x, y), color)

func _ring(rect: Rect2i, inner: float, outer: float) -> void:
	for y in rect.size.y:
		for x in rect.size.x:
			var radius := (Vector2(x, y) + Vector2.ONE * 0.5 - Vector2(rect.size) * 0.5).length()
			var inside := radius >= inner and radius <= outer
			var distance := minf(absf(radius - inner), absf(radius - outer))
			image.set_pixelv(rect.position + Vector2i(x, y), _ink(distance, inside))

func _lane(frame: int) -> void:
	for y in 64:
		for x in 256:
			var p := Vector2(x + 0.5, y + 0.5)
			var inside := p.x >= 4 and p.x <= 252 and p.y >= 4 and p.y <= 60
			var distance := minf(minf(absf(p.x - 4), absf(p.x - 252)), minf(absf(p.y - 4), absf(p.y - 60)))
			if not inside:
				distance = (p - p.clamp(Vector2(4, 4), Vector2(252, 60))).length()
			var color := _ink(distance, inside)
			# Restrained travelling glints in the repeatable middle; end caps stay fixed.
			if x >= 16 and x < 240:
				var light := pow(maxf(cos((x - 16) * TAU / 32.0 - frame * PI / 2), 0), 8)
				var inset := minf(absf(p.y - 9), absf(p.y - 55))
				color.a = minf(color.a + light * exp(-pow(inset / 1.2, 2)) * 0.24, 1)
			if x < 2 or x >= 254 or y < 2 or y >= 62: color.a = 0
			image.set_pixel(x + frame * 256, y + 1600, color)
			if frame == 0:
				var outline := _ink(distance, false, true)
				if x < 2 or x >= 254 or y < 2 or y >= 62: outline.a = 0
				image.set_pixel(x, y + 1664, outline)
