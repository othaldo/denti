class_name DentipediaData
extends RefCounted

const CATEGORIES := ["Waffen", "Items", "Relikte", "Werte", "Mechaniken", "Verzauberungen"]
const ASCENSION_OVERVIEW := "Ab Mk IV kannst du die gewählte Waffe mit Punkten und Gold gezielt auf Mk V, VI und höher bringen. Je Wurzel kosten die Aufstiege 3/5/8/12 Punkte und 60/100/160/240 Gold. Zwei-Wurzel-Waffen bezahlen das Doppelte; im Endlosmodus steigt der Goldanteil mit dem Endlosfaktor. Jeder Aufstieg gibt additiv +10 % Basisschaden sowie +3 % Tempo und Reichweite. Vier Effektplätze und das Mk-IV-Angriffsmuster gelten weiter. Rückgängig nimmt den geplanten Schritt zurück; Fertig übernimmt Punkte, Gold und Waffe gemeinsam. Beim Fortsetzen bleibt der Entwurf erhalten."
const ENCHANTMENT_OVERVIEW := "Upgrade-Kapseln geben Waffenpunkte. Wähle im Verzauberungsfenster zuerst ein konkretes Waffenexemplar. Jede Kapsel gibt zwei Punkte. Ein Rang kostet einen Punkt je belegter Wurzel: 1 bei kleinen, 2 bei großen Waffen. Aktivieren startet bei 1/10; höchstens 10/10. Der Effekt gilt nur für diese Waffe.\n\nMk I, II, III und IV besitzen einen, zwei, drei und vier Effektplätze. Alle vier sind sichtbar; gesperrte Plätze öffnen sich beim Mk-Aufstieg der Waffe. Waffenpunkte kaufen keine zusätzlichen Plätze.\n\nPro Waffe ist ein Element wählbar: Feuer, Eis, Gift, Blutung, Elektro oder Wasser. Andere Plätze tragen Reichweite, Angriffstempo, Lebensraub, Krit-Chance, Krit-Schaden oder Wucht. Auch ein Ausbau ohne Element ist möglich. Die Wurzelkosten beeinflussen die Effektstärke; die Vorschau zeigt den Wert für deine Zielwaffe.\n\nRückgängig nimmt geplante Schritte zurück. Fertig übernimmt die Verteilung. Unverbrauchte Punkte bleiben erhalten und lassen sich später, auch über Verzaubern im Shop, ausgeben. Bei einer Fusion wählst du bei Bedarf die Effekte des Ergebnisses; nicht übernommene Punkte werden erstattet. Bei anderen Wurzelkosten werden die investierten Punkte in bezahlbare Ränge umgerechnet." + "\n\n" + ASCENSION_OVERVIEW
const ENCHANTMENT_SYNERGIES := {
	&"fire": "Flächenwaffen und Explosionen können mehrere brennende Gegner besiegen und Glut freisetzen.",
	&"ice": "Krit-Chance und Glanz lösen Eissplitter häufiger aus. Krit-Schaden verstärkt den zugehörigen Basistreffer.",
	&"poison": "Angriffstempo baut Gift auf. Reichweite hilft, robuste Ziele beim Ausweichen weiter zu vergiften.",
	&"bleed": "Zahnseide-Spule, Blutungsuhr und Skalpellwachs verstärken den Blutungsbuild. Ansteckende Zahnseide und Blutmond-Zahn verteilen Blutung beim Tod.",
	&"electric": "Wasserflosser oder Wasser auf einer anderen Waffe bereiten Gegner vor. Funkensonde und andere Kettenitems erlauben einen weiteren, stärkeren Sprung; Leitlack verstärkt Elektro gegen nasse Ziele.",
	&"wet": "Elektro erhält gegen nasse Startziele mehr Sprünge und Reichweite. Leitlack verlängert Nässe; mit Spülventil können die Treffer Spülpfützen erzeugen.",
	&"holy": "Glanz, Krit-Items und schnelle Treffer helfen, die Markierungen auszulösen. Eis erzeugt bei Krits zusätzlich Splitter.",
	&"leech": "Ergänzt Heilungs- und Schutzbuilds. Speichelkelch kann überschüssige Heilung in Schildfortschritt umwandeln. Weitere Waffen mit Lebensraub heilen unabhängig. Salven und Flächentreffer derselben Waffe teilen sich ihr Intervall.",
	&"range": "Ergänzt Gift und andere Fernkampf-Builds: mehr Abstand halten und trotzdem weiter treffen.",
	&"crit": "Ergänzt Eis, Glanz und Krit-Items: mehr kritische Basistreffer und häufigere Auslöser.",
	&"crit_damage": "Ergänzt Krit-Chance und Waffen mit garantierten Krits. Elementschaden wird nicht mitmultipliziert.",
	&"knockback": "Ergänzt Reichweite, Eis und Wasser: mehr Abstand zu gewöhnlichen Gegnern. Stark rückstoßresistente Ziele bleiben standhaft.",
	&"tempo": "Hilft Gift beim Aufbau, Blutung bei wiederholten Treffern und Krit-Items bei häufigeren Treffern. Gemeinsame Effektintervalle bleiben bestehen.",
}
const TOPICS := {
	"Verzauberungen": ENCHANTMENT_OVERVIEW,
	"Mk V+ & Waffenaufstieg": ASCENSION_OVERVIEW,
	"Waffenpunkte & Effektplätze": "Jede neue Upgrade-Kapsel gibt zwei frei verteilbare Punkte. Auch goldene Kapseln geben zwei Punkte; goldene Träger und Goldzahn-Gauner können zusätzliche Funde liefern. Einsammeln unterbricht die Welle nicht.\n\nAktivieren startet auf 1/10. Jeder Rang kostet einen Punkt pro belegter Wurzel: kleine Waffen 1, große Waffen 2. Ein Effekt belegt unabhängig vom Rang einen Platz. Vier Effekte auf 10/10 kosten 40 Punkte für eine kleine oder 80 für eine große Waffe. Sechs kleine und drei große Waffen benötigen dadurch gleich viele Kapseln.\n\nGlück kann nach jeder Welle eine Bonuskapsel bringen: 10 % Chance bei 100 Glück, Obergrenze 25 %. Runenpolitur gibt für jede fünfte seit dem Kauf gesammelte Kapsel eine weitere. Bonuskapseln zählen nicht mit. Der Fortschritt bleibt über Wellen und Fortsetzen erhalten.\n\nMk I: 1 Platz\nMk II: 2 Plätze\nMk III: 3 Plätze\nMk IV: 4 Plätze\n\nGleiche Waffen im Build sind getrennte Ziele. Wähle das gewünschte Exemplar, bevor du Punkte verteilst. Mk I bis IV bestimmen die Plätze; höhere Mk-Stufen verstärken die Waffenbasis. Der Effektrang bestimmt den Ausbau des jeweiligen Effekts. Restpunkte und offene Verteilungen bleiben beim Fortsetzen erhalten.",
	"Elemente & Waffenformen": "Feuer: Brandschaden und Glut.\nEis: Schaden, Verlangsamung und Eissplitter bei passenden Krits.\nGift: Schaden über Zeit und Giftaufbau.\nBlutung: Schaden über Zeit mit Blutungs-Synergien.\nElektro: direkte Treffer und Kettenblitze.\nWasser: direkter Schaden und Nässe.\n\nEine Waffe kann höchstens eines dieser Elemente neu erhalten. Blutung und Wasser zählen ebenfalls als Elemente. Kombiniere deshalb zum Beispiel Wasser auf einer Waffe mit Elektro auf einer anderen. Details und Grenzen stehen in den einzelnen Verzauberungseinträgen.\n\nAlle Standardwaffen und Spezialwaffen besitzen eine Normalform und sechs Elementformen. Die Auswahl zeigt die passende Form bereits vor dem Bestätigen. Im Kampf folgen Geschosse, Fäden, Nahkampfspuren und Einschläge dem gewählten Element.\n\nKurze Bodenspuren eines Elementtreffers zeigen den Einschlag und verursachen selbst keinen zusätzlichen Schaden. Spülpfützen oder andere Bodenwirkungen von Items sind eigene Effekte.",
	"Manuelle Verzauberungsfusion": "Bei einer Evolution erscheint eine Fusionsvorschau. Bei einer normalen Mk-Fusion öffnet sie sich, wenn Plätze, Elemente oder Ränge kollidieren. Die Ausgangswaffen bleiben unverändert, bis du bestätigst.\n\nWähle die Effekte, die die fertige Waffe behalten soll: höchstens ein Element und so viele Effekte wie ihre Mk-Stufe erlaubt, maximal vier. Gleiche Effekte legen ihre investierten Punkte zusammen. Die Wurzelkosten der fertigen Waffe bestimmen daraus die Ränge, höchstens bis 10/10. Beide Ausgangswaffen können also zusammen mehr Effekte besitzen, als das Ergebnis aufnehmen kann.\n\nNicht verwendete Punkte werden vollständig erstattet. Beispiel: Zwei Waffen mit je einer Wurzel und Feuer 7/10 plus 6/10 ergeben bei einer Wurzel Feuer 10/10 und drei freie Punkte. Bei einem Ergebnis mit zwei Wurzeln werden daraus Feuer 6/10 und ein freier Punkt. Die Stärke übernommener Effekte wird für die fertige Waffe neu berechnet.\n\nErstattete Punkte kannst du direkt im Shop über Verzaubern verteilen oder aufbewahren. Abbrechen verbraucht keine Zutaten. Eine unbestätigte Fusionsauswahl wird beim Fortsetzen verworfen; beide ursprünglichen Waffen bleiben erhalten.",
	"Waffenmeisterschaften": "Jede der 18 Startwaffen besitzt vier dauerhafte Auszeichnungen. Zahnprüfung: Besiege den ersten Boss in Welle 5, auch auf Easy. Bronze: Gewinne auf Normal. Silber: Gewinne auf Hard. Gold: Gewinne auf Hell. Ein höherer Sieg schließt die niedrigeren Medaillen ein.\n\nEs zählt die beim Runstart bestätigte Waffe. Verkauf, Fusion und Evolution ändern sie nicht. Story und Arena zählen gleichermaßen. Erreichte Siegel bleiben bei Niederlage und Endlos erhalten und verleihen keine Statboni.\n\nDas eigene Menü Achievements zeigt deinen persönlichen Stand, alle Waffen und die Anforderungen. Du erreichst es im Hauptmenü und in der Zahnpause. Neue Erfolge erscheinen nach der Welle und im Run-Rückblick.\n\nDebug-Eingriffe und Testarenen vergeben keine neuen Siegel. Alte laufende Spielstände ohne gespeicherte Startwaffe bleiben spielbar; für Meisterschaften beginne einen neuen Run.",
	"Wurzeln & Fusionieren": "Wurzeln sind Ausrüstungsplätze. Eine Waffe belegt eine oder zwei; ihren Bedarf zeigt die Waffenkarte. Die aktuelle Belegung steht im Shop. Waffenpunkte und Effektplätze sind davon getrennt.\n\nZwei gleiche Waffen derselben Mk-Stufe lassen sich bis Mk IV fusionieren. Das Ergebnis übernimmt je Attribut den besseren Grundwert beider Waffen und die investierten Münzen. Bei freien Wurzeln bleibt ein gekaufter Zwilling zunächst ein eigenes Exemplar; bei voller Ausrüstung kann ein passender Kauf fusionieren.\n\nWähle eine ausgerüstete Waffe für Vergleich, Fusion oder Verkauf. Ein grüner Pfeil zeigt eine verfügbare Fusion oder Evolution. Bei Konflikten entscheidest du in der manuellen Verzauberungsfusion über die Effekte und erhältst übrige Ränge als Punkte zurück.\n\nManche Mk-IV-Waffen können mit passenden Build-Zutaten zu Spezialwaffen werden. Das Spiel zeigt das Rezept erst, wenn die Voraussetzungen erfüllt sind. Nach der ersten bestätigten Evolution wird der Eintrag mit Zutaten in der Dentipedia freigeschaltet. Items bleiben erhalten; beteiligte Waffen werden ersetzt.",
	"Zahnseidenpeitsche & Schneide": "Die Zahnseidenpeitsche besitzt einen Faden, die Zahnseiden-Schneide zwei. Die Schneide ist die frühere Garotte. Ihre Griffe bleiben bei Denti; nur die verbundenen Fäden fahren nach vorn aus und ziehen sich zurück.\n\nDie Fäden treffen mehrere Gegner entlang ihres sichtbaren Wegs. Nahe Ziele begrenzen den Schlag nicht. Beide Waffen verursachen Blutung; die Schneide stößt Gegner zusätzlich zurück. Zwei Fäden wenden den Waffentreffer auf dasselbe Ziel trotzdem nur einmal pro Angriff an.\n\nAusholen und Rückzug verursachen keinen Schaden. Die Waffen treffen nicht mehr unsichtbar im Rundumradius oder in einem breiten Frontfächer. Das gewählte Element animiert den Faden selbst. Reichweite, Schaden und Angriffspause stehen bei der jeweiligen Waffe.",
	"Wurzelsprung & Ausdauer": "Shift löst den Dash in Bewegungsrichtung aus. Stehst du still, springt Denti in die zuletzt verwendete Richtung. Auf Touchgeräten nutzt du den Dash-Button unten rechts.\n\nGegner brechen den Wurzelsprung nicht ab. Körperkontakt während des Dashes verursacht aber mehr Schaden. Wände und Arenarand stoppen ihn weiterhin. Der Dash gewährt keine zusätzlichen Schutzframes; Härte, Zahnflutsch, Schild und vorhandene Trefferpausen gelten weiter.\n\nWurzelkraft erhöht den Ausdauervorrat, nicht die Regeneration pro Sekunde. Ein größerer Vorrat speichert mehrere schnelle Dashes. Die Regeneration beginnt nach der Erholungspause; zu Beginn jeder Welle wird der Vorrat aufgefüllt.",
	"Heilung, Schild & Ausweichen": "Speichel regeneriert Leben. Heilungsitems können weitere Heilungen oder Vorteile durch Überheilung erzeugen. Lebensraub heilt durch wirksame Waffentreffer mit einem eigenen Intervall je Waffenexemplar und einer Obergrenze pro Impuls. Schaden über Zeit und Folgeeffekte lösen keinen Lebensraub aus.\n\nSchildladungen fangen Treffer ab. Zahnflutsch gibt eine Ausweichchance bis maximal 60 %; ein ausgewichener Treffer verbraucht keine Schildladung. Härte reduziert erlittenen direkten Schaden und Blutung. Gift ignoriert Härte.\n\nMehrere Waffen mit Lebensraub können unabhängig voneinander heilen. Ein Dash ersetzt keine Verteidigung: Er endet beim Kontakt mit einem Gegner zwar nicht, der Körperkontakt ist währenddessen aber gefährlicher.",
	"Strom & Nass": "Wasser- und Lichttreffer springen mit einem passenden Kettenitem auf einen nahen Gegner über. Die Verzauberung Elektro erzeugt eigene Kettenblitze auch ohne dieses Item.\n\nWasserwaffen und die Verzauberung Wasser durchnässen Gegner. Wasser verursacht eigenen Zusatzschaden: Zucker erleidet davon 50 %, Plaque 25 % mehr. Ein nasses Startziel erlaubt Elektro einen weiteren Sprung und erhöht die Sprungreichweite. Kettenitems ergänzen einen weiteren, stärkeren Elektrosprung. Leitlack verstärkt Wasser-, Licht- und Elektro-Verzauberungsschaden gegen nasse Ziele.\n\nWasser und Elektro werden auf verschiedene Waffen verteilt, weil jede Waffe nur ein Element erhalten kann. Gemeinsame Intervalle und Zielgrenzen verhindern endlose Ketten. Die genauen Regeln stehen bei den beiden Verzauberungen.",
	"Blutung": "Schnittwaffen mit Blutungswert verursachen zusätzlich Schaden über Zeit. Mehrere Treffer stapeln Blutung bis zur Grenze der Quelle. Der Waffeneintrag zeigt Stärke und Dauer. Die Verzauberung Blutung zählt als Element und ist eine zusätzliche Blutungsquelle.\n\nBlutungsitems verbessern Stärke, Dauer, Stapelzahl oder Schaden gegen blutende Gegner. Ansteckende Zahnseide und Blutmond-Zahn können Blutung nach einem Kill verteilen. Halte robuste Gegner unter Blutung und bleibe in Bewegung.\n\nBlutung an Denti wird durch Härte reduziert; Gift ignoriert Härte. Laufende Statusschäden an Denti enden nach dem Kampf.",
	"Kritische Treffer & Fokus": "Glanz erhöht die Chance auf kritische Waffentreffer. Der Krit-Multiplikator gehört zur Waffe. Krit-Chance und Krit-Schaden als Verzauberung verbessern nur das gewählte Waffenexemplar. Krit-Schaden multipliziert kritische Basistreffer, nicht den zusätzlichen Elementschaden.\n\nFokus belohnt wiederholte Angriffe auf dasselbe Ziel. Die Waffe gibt den maximalen Bonus vor. Zielwechsel oder eine Angriffslücke unterbrechen solche Serien. Der Polierer zählt dagegen seine Angriffe pro Waffenexemplar: Jeder dritte Angriff ist garantiert kritisch. Zielwechsel und Angriffspausen löschen diesen Fortschritt nicht. Auch ein verfehlter Angriff zählt.\n\nKrits auf gekühlte Ziele können Eissplitter auslösen. Krit-Items können weitere Folgeeffekte erzeugen. Diese haben eigene Grenzen und starten keine endlosen Wirkungsketten.",
	"Schmelzbruch": "Schmelz ist Dentis maximales Leben. Schmelzbruch bezeichnet dagegen den Schmelzschaden einer Waffe und seine Verwundbarkeits-Synergien.\n\nFluorid-Sprüher kann Ziele für Schmelzwaffen anfälliger machen, etwa Zauberbürste oder Fluorid-Rakete. Stärke und Dauer stehen beim Waffeneintrag. Mehrere solche Markierungen stapeln ihren Bonus nicht unbegrenzt.",
	"Geschosse & Flächenschaden": "Durchschlag lässt ein Geschoss weitere Gegner treffen. Zusätzliche Geschosse verbreitern eine Salve. Explosionsradius bestimmt, wie weit ein Flächentreffer reicht.\n\nDas Element bestimmt den Geschosskern, Begleitpartikel und Einschlag. Ein Einschlag kann als Glut, Eissplitter, Giftschleim, Entladung, Blut- oder Wasserspritzer sichtbar bleiben, auch wenn das Projektil bereits verschwunden ist.\n\nItem-Folgeeffekte haben teilweise eigene Abklingzeiten und Zielgrenzen. Ihr Schaden stammt aus dem auslösenden Treffer; sie starten keine rekursiven Proc-Ketten. Sichtbare Partikel sind keine zusätzlichen Schadensquellen.",
	"Waffenwerte & Rollqualität": "Mk-Stufe und gewürfelte Grundwerte sind zwei getrennte Eigenschaften. Shopwaffen würfeln Schaden, Angriffstempo, Reichweite und Crit. Die Wertefarben zeigen ihre Qualität; der Waffenrahmen zeigt Mk.\n\nReservieren und Fortsetzen behalten diese Werte. Eine Mk-Fusion nimmt bei jedem Attribut den besseren Wert ihrer Zutaten. Das Vorschaufenster zeigt dir die fertige Waffe vorab.\n\nWaffenkarten im Run berücksichtigen deinen Build. Die Dentipedia zeigt die Basiswerte der Waffen. Bisskraft, Nah- oder Fernschaden, Putzeifer, Items und Verzauberungen verändern die tatsächlichen Treffer und Angriffspausen.",
	"Shop & Münzen": "Die Karte öffnet Details; der Preisbutton kauft direkt. Fehlen Münzen oder Wurzeln, oder ist ein Stapellimit erreicht, bleibt der Kauf gesperrt. Du kannst das Angebot weiterhin ansehen.\n\nDer Pin merkt ein Angebot kostenlos und bindet seinen Preis über Rerolls und Wellen. Wiederholtes Neuwürfeln wird teurer. Sind alle Angebote gemerkt, musst du zuerst eines freigeben. Auch Stat-Angebote beim Aufstieg lassen sich gegen Münzen neu würfeln.\n\nWähle eine belegte Wurzel, um Waffen zu vergleichen, zu fusionieren oder nach Bestätigung zu verkaufen. Verkauf erstattet Münzen und entfernt die Waffe samt Effekten; er ist keine Rückgabe der Waffenpunkte. Punkteerstattung gehört zur manuellen Fusion.\n\nRestpunkte verteilst du über Verzaubern. Items und Relikte bleiben unten als anklickbare Symbole erreichbar. Glück verbessert Beute und Seltenheiten innerhalb fester Grenzen; passende Build-Angebote sind wahrscheinlicher, aber nicht garantiert.",
	"Seltenheiten & Stapeln": "Rahmen und Hintergrund zeigen die Seltenheit. Items derselben Familie teilen sich ein Familienlimit über alle Seltenheiten hinweg. Eine seltenere Variante ersetzt vorhandene Exemplare nicht automatisch. Die konkrete Grenze steht beim Item; mythische Items sind einmalig pro Run.\n\nMk I bis IV bestimmen Waffenstufe und Effektplätze. Ein Effektrang von 1/10 bis 10/10 ist davon unabhängig. Neue Waffenpunkte würfeln keine Effekt-Seltenheiten und keine zusätzlichen Mk-Stufen.\n\nWaffen-Evolutionen verändern die Waffenform, ohne eine zusätzliche Mk-Stufe zu sein. Mk V und höher kaufst du ab Mk IV gezielt mit Punkten und Gold im Verzauberungsfenster. Alte Kapselangebote bleiben als Altbestand erhalten.",
	"Wellen & Belohnungen": "Während der Welle steuerst du Denti und sammelst XP, Münzen und Upgrade-Kapseln. Erreichte Level und Waffenpunkte werden vorgemerkt. Das Einsammeln öffnet keine Auswahl und unterbricht den Kampf nicht.\n\nAm Wellenende wird zuerst die übrige Beute eingesammelt. Danach folgen vorgemerkte Aufstiege, eventuell gespeicherte alte Fundentscheidungen, Waffenverzauberung, Bossrelikt und gegebenenfalls Storydialog. Erst anschließend öffnet die Zahnklinik.\n\nEin Aufstieg verbessert einen Grundwert; Waffenpunkte bauen gezielt einzelne Waffen aus. Münzen bezahlen Shopkäufe und Rerolls. Diese drei Fortschrittsarten sind unabhängig. Bosswellen enden erst, wenn die erforderlichen Bosse besiegt sind.",
	"Goldzahn-Gauner": "Der Goldzahn-Gauner ist ein seltener Beutedieb in normalen Wellen. Er sammelt lose Münzen, flieht vor Denti und sucht Deckung hinter anderen Gegnern. Pro Welle kann höchstens ein Gauner auftreten.\n\nBesiegst du ihn rechtzeitig, bekommst du seine gesammelten Münzen zurück und eine goldene Upgrade-Kapsel. Entkommt er am Wellenende, ist der Inhalt seines Beutels verloren. Die goldene Kapsel gibt zwei zusätzliche Waffenpunkte.\n\nEin Umweg zum Gauner kann sich lohnen, kostet aber sichere Positionierung. Sein Beutel und Zustand bleiben beim Fortsetzen erhalten.",
	"Gegner, Eliten & Bosse": "Plaque bedrängt durch Masse, Bakterien verfolgen schnell und Zucker hält mehr aus und kann anstürmen. Säurespucker kündigen ihre Fernangriffe an. Giftkeime schießen Giftfächer; Zahnfleischbeißer verursachen Blutung mit ihren Anstürmen.\n\nDie Säurekrone kündigt Projektilringe an. Der Jagdkeim bringt Begleiter mit, beschleunigt nahe Gegner und stürmt selbst an. Eliten besitzen einen sichtbaren Schmelzschild gegen hohen Schaden in kurzer Zeit.\n\nWellenprofile verändern die Mischung gewöhnlicher Gegner. Bursts, Horden und spätere zusätzliche Elite-Gruppen erhöhen den Druck. Welle und Schwierigkeit bestimmen Werte, Häufigkeiten und Statuseigenschaften.\n\nBossangriffe haben Warnzeichen. Halte freie Ausweichwege und achte neben dem Boss auf Adds, Geschosse und Bodenflächen. Eigene Elementeffekte machen feindliche Warnungen nicht ungefährlich.",
	"Bosskämpfe & Entzündung": "Bossränge folgen in Welle 5, 10, 15 und 20. Ihre Angriffe reichen von angekündigten Bahnen und Anstürmen bis zu Flächen, Geschossmustern und Verstärkung. Schutzphasen begrenzen kurze Schadensspitzen.\n\nLäuft die Zeit ab, bleibt der Bosskampf aktiv. Der Boss wird Entzündet: Schaden, Verteidigung, Tempo, Angriffstakt und Leben wachsen mit jeder weiteren Sekunde. Seine Aura und die Anzeige im HUD zeigen die Eskalation.\n\nEntzündung heilt den Boss nicht vollständig; aktuelle und maximale Lebenspunkte wachsen im gleichen Verhältnis. Warnzeiten bleiben erhalten. Aufschieben macht den Kampf deshalb gefährlicher, auch wenn sein Leben schon niedrig ist.\n\nNach den frühen Bossabschlüssen wählst du ein göttliches Relikt. Relikte verändern den Build und bleiben bis zum Run-Ende erhalten; ihre Effekte stehen in der eigenen Kategorie.",
	"Spielmodi & Schwierigkeit": "Vor einem neuen Run wählst du den Modus, die Schwierigkeit und eine Standardwaffe. Easy, Normal und Hard stehen direkt bereit; ein Sieg auf Hard schaltet Hell frei. Die Schwierigkeit bleibt beim Fortsetzen erhalten.\n\nHöhere Grade verändern Gegnerdruck, Horden, Eliten, Geschossmuster und Statuseffekte. Ein anderer Grad ist deshalb mehr als nur mehr Gegnerleben.\n\nDer Story-Modus verbindet den Run mit Schauplätzen, Bossabschlüssen und kurzen Dialogen. Zukünftige Orte bleiben verborgen, bis du dort ankommst. Die Kämpfe und die Belohnungsreihenfolge bleiben erhalten.",
	"Endlosmodus": "Nach dem Sieg in Welle 20 kannst du Endlos weiterspielen wählen. Der Sieg zählt bereits. Dein Build, deine Münzen und dein verbleibendes Leben bleiben erhalten; der Wechsel heilt dich nicht kostenlos.\n\nNach den offenen Belohnungen führt der Shop in Welle 21. Endloswellen dauern 60 Sekunden; Gegnerdruck, Gegnerwerte und Preise steigen weiter. Bosswellen bleiben nach Zeitablauf aktiv, bis ihre Bosse besiegt sind.\n\nAlle fünf Wellen kommt ein Boss. In Welle 30, 40 und weiteren Zehnerwellen treten zwei Bosse auf; der Lebensbalken zeigt ihr gemeinsames Leben. Auch Endlosruns lassen sich speichern und fortsetzen.",
	"Speichern & Fortsetzen": "Der Run speichert Kampfzustand, Ausrüstung, Waffenwerte, Verzauberungen, Münzen und den aktuellen Fortschritt. Fortsetzen lädt auch offene Belohnungen und nicht ausgegebene Waffenpunkte.\n\nEin offener Verzauberungsentwurf bleibt erhalten und ändert den Build erst nach Fertig. Eine noch unbestätigte Fusionsauswahl wird dagegen verworfen; die ursprünglichen Waffen bleiben erhalten.\n\nEin neuer Run ersetzt den bisherigen erst beim bestätigten Start. Freigeschaltete Schwierigkeiten und entdeckte Spezialwaffen gehören zum dauerhaften Fortschritt und bleiben auch nach Run-Ende bestehen.",
	"Alte Spielstände": "Bereits bezahlte alte Effekte bleiben erhalten, auch frühere Kombinationen mehrerer Elemente oder zusätzliche belegte Plätze. Neue Investitionen folgen den aktuellen Grenzen. Weihe ist nur noch Altbestand und nicht neu auswählbar.\n\nAlte, schon ausgewürfelte Kapselangebote und gespeicherte Itemfunde werden mit ihren bisherigen Entscheidungen aufgelöst. Das können auch Slot- oder Mk-Aufstiege sein. Neue Kapseln geben stattdessen zwei Waffenpunkte. Alte freie Punkte werden einmalig verdoppelt; offene Entwürfe werden mit den aktuellen Wurzelkosten neu geprüft.\n\nBei einem Elementwechsel in der manuellen Fusion gelten höchstens ein Element und vier Plätze. Nicht übernommene Ränge gehen als freie Punkte zurück. Die neue Waffenform richtet sich bei alten gemischten Waffen nach ihrem stärksten Element.",
	"Bedienung & Einstellungen": "WASD oder Pfeiltasten bewegen Denti; Waffen greifen automatisch an. Shift aktiviert den Wurzelsprung. Escape schließt zuerst offene Details und öffnet sonst die Pause.\n\nAuf Touchgeräten ziehst und hältst du auf der freien Spielfläche zum Bewegen. Nachziehen ändert die Richtung, Loslassen stoppt. Ein zweiter Finger kann den Dash-Button unten rechts betätigen. Menüs, Karten und Details bedienst du per Tippen.\n\nIn der Pause erreichst du Werte, Items, Dentipedia und Einstellungen. Lautstärke, UI-Klänge, reduzierte UI-Bewegung und FPS-Anzeige lassen sich dort anpassen. Das Lesen in der Dentipedia setzt einen pausierten Kampf nicht fort.",
}

static func entries(category: int, discovered: Array[String]) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	match category:
		0:
			for weapon in WeaponCatalog.ALL:
				result.append(_weapon(weapon))
			for recipe in WeaponEvolutions.ALL:
				if discovered.has(str(recipe.id)):
					var entry := _weapon(recipe.result)
					entry["recipe"] = recipe
					result.append(entry)
				else:
					# No name, recipe, stats or search keywords until actually discovered.
					result.append({"title": "Unbekannte Spezialwaffe", "icon": recipe.result.sprite, "locked": true, "body": "Noch nicht fusioniert."})
		1:
			for item in ItemCatalog.ALL:
				result.append({"title": item.display_name, "icon": item.icon_texture if item.icon_texture != null else DentiUIIcons.item(item.icon_index), "body": item.effect_text() + "\n\n" + item.limit_text(), "rarity_tier": item.rarity_tier})
		2:
			for relic in RelicCatalog.CATALOG:
				result.append({"title": relic.display_name, "icon": DentiUIIcons.relic(relic.icon_index), "body": DentiAttributes.resolve_text(relic.description), "rarity_tier": 4, "rarity_caption": "Göttliches Relikt"})
		3:
			for type in DentiAttributes.ACTIVE:
				result.append({"title": DentiAttributes.name_for(type), "icon": DentiUIIcons.stat(DentiAttributes.ICONS[type]), "body": DentiAttributes.meaning_for(type)})
		4:
			for title in TOPICS:
				result.append({"title": title, "body": topic_body(title)})
		5:
			result.append({"title": "Verzauberungen", "body": enchantment_overview()})
			for data in WeaponAffixes.ALL:
				result.append(_enchantment(data))
	return result

static func topic_body(title: String) -> String:
	if title == "Verzauberungen": return enchantment_overview()
	var body := str(TOPICS.get(title, ""))
	match title:
		"Wurzelsprung & Ausdauer":
			var dash := PlayerDash.DEFAULT
			body = ("%.0f Ausdauer je Dash · %.2f s Abklingzeit\n%.0f Ausdauer/s Regeneration\n%.2f s Erholungspause nach dem Dash\n+%.0f %% Körperkontaktschaden während des Dashes\n\n" % [dash.cost, dash.cooldown, dash.recharge_rate, dash.recovery_delay, (dash.contact_damage_multiplier - 1) * 100]) + body
		"Heilung, Schild & Ausweichen":
			var leech := WeaponAffixes.by_id(&"leech")
			body += "\n\nLebensraub: frühestens alle %.2f s ein Heilimpuls je Waffenexemplar. Salven und Flächentreffer dieser Waffe teilen das Intervall. Höchstens %.1f HP pro Wurzel je Impuls; der Waffeneintrag zeigt deinen ausgebauten Wert." % [leech.proc_cooldown, leech.utility_cap]
		"Goldzahn-Gauner":
			var goblin: LootGoblinData = preload("res://data/encounters/loot_goblin.tres")
			body += "\n\nKann ab Welle %d auftauchen." % goblin.first_wave
		"Wellen & Belohnungen":
			body += "\n\nBeim Aufstieg wählst du einen von %d Stat-Boni. Waffenpunkte werden anschließend gezielt verteilt." % ChoicePanel.UPGRADE_COUNT
	return body


static func enchantment_overview() -> String:
	var names: PackedStringArray = []
	for data in WeaponAffixes.ALL:
		if data.selectable: names.append(data.display_name)
	return ENCHANTMENT_OVERVIEW + "\n\nNeu auswählbar: " + ", ".join(names) + "."

static func _enchantment(data: WeaponAffixData) -> Dictionary:
	var body := AffixPresentation.effect_description(data.id)
	if not data.selectable: body = "Altbestand: nicht mehr neu auswählbar. Vorhandene Effekte bleiben erhalten.\n\n" + body
	if data.dot_duration > 0:
		body += "\n\nJeder Treffer verursacht zusätzlichen Schaden über %.0f Sekunden. Weitere Treffer addieren ihren eigenen Schaden, ohne den bereits laufenden Schaden erneut zu multiplizieren." % data.dot_duration
	if data.slow_fraction > 0:
		body += "\n\nVerlangsamt normale Gegner um %.0f %% für %.1f Sekunden. Gegen Eliten und Bosse ist die Verlangsamung schwächer. Angekündigte Anstürme werden nicht verlangsamt." % [data.slow_fraction * 100, data.slow_duration]
	var mechanics := AffixPresentation.mechanics_text(data.id).replace("eines Trefferbudgets", "des Feuerschadens eines Treffers")
	if not mechanics.is_empty():
		body += "\n\n" + mechanics
	if data.stat_key != &"":
		body += "\n\nGilt nur für die gewählte Waffe und belegt einen ihrer Verzauberungsplätze. Andere ausgerüstete Waffen behalten ihre bisherigen Werte."
	body += "\n\nPasst zu deinem Build:\n" + str(ENCHANTMENT_SYNERGIES.get(data.id, ""))
	body += "\n\nDie konkreten Werte hängen von Ausbau, Waffe und Build ab. Verzauberungsfenster und Waffendetails zeigen die Werte für deine Waffe."
	return {"title": data.display_name, "enchantment_id": str(data.id), "icon": DentiUIIcons.item(data.icon_index), "body": body}

static func _weapon(data: WeaponData) -> Dictionary:
	var body := data.description.trim_prefix(data.roots_text() + " · ") + "\n\n" + data.roots_text() + " · " + data.combat_text()
	if data.attack_animation == "floss_cut":
		body += "\n\n" + ("Die Griffe bleiben" if data.floss_right_texture != null else "Der Griff bleibt") + " bei Denti. Ausholen und Rückzug verursachen keinen Schaden."
		if data.id == &"floss_garrote": body += " Die Schneide ist die frühere Garotte."
	for tier in ([4] if data.evolution_kind != &"" else [1, 2, 3, 4]):
		body += "\n\n%s: %s" % [WeaponPresentation.tier_text(data, tier), data.stats_text(tier)]
	body += "\n\nBasiswerte ohne deinen Build. Bisskraft, Nah-/Fernschaden, Putzeifer und Items verändern die tatsächlichen Kampfwerte."
	return {"title": data.display_name, "icon": data.sprite, "body": body, "evolved": data.evolution_kind != &"", "weapon_data": data}

static func ingredients(recipe: WeaponEvolutionRecipe) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for id in [recipe.base_weapon, recipe.partner_weapon]:
		if id != &"":
			var data := WeaponCatalog.by_id(id)
			result.append({"title": data.display_name + " IV", "icon": data.sprite})
	for family in recipe.families:
		for item in ItemCatalog.ALL:
			if item.family_id == family:
				var family_name: String = {&"chain": "Ketten", &"bleed": "Blutung", &"damage": "Bisskraft", &"return": "Rückflug"}.get(family, str(family))
				result.append({"title": family_name + "-Familie\nJede Seltenheit", "icon": item.icon_texture if item.icon_texture != null else DentiUIIcons.item(item.icon_index)})
				break
	for id in recipe.items:
		var item := ItemCatalog.by_id(id)
		result.append({"title": item.display_name, "icon": item.icon_texture if item.icon_texture != null else DentiUIIcons.item(item.icon_index)})
	return result
